   "source": [
    "# Installation\n",
    "\n",
    "1. create a venv\n",
    "\n",
    "````\n",
    "python3 -m venv .venv  \n",
    "\n",
    "````\n",
    "\n",
    "2. install libraries :"
   ]
  },
  {
   "cell_type": "raw",
   "metadata": {},
   "source": [
    "%pip install -q -U -r requirements.txt"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "vscode": {
     "languageId": "raw"
    }
   },
   "source": [
    "3. activate it:\n",
    "\n",
    "````\n",
    "source .venv/bin/activate      \n",
    "\n",
    "````\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "\n",
    "## Appendix: version of the libraries that were used"
